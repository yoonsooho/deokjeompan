{
  "name": "cutlog",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @cutlog/api",
    "dev:web": "npm run dev -w @cutlog/web",
    "build": "npm run build -w @cutlog/api && npm run build -w @cutlog/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "concurrently -k -n api,web npm:start:api npm:start:web",
    "start:api": "npm run start -w @cutlog/api",
    "start:web": "npm run start -w @cutlog/web",
    "prepare": "husky",
    "test": "npm run build -w @cutlog/api && node --test apps/api/test/*.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "typescript": "~5.9.3"
  }
}
