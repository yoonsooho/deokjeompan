    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@cutlog/contracts": "0.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
